# ═══════════════════════════════════════════════════════════════════════════
# NEXUS ALPHA — Environment Configuration Template
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to source control.
# ═══════════════════════════════════════════════════════════════════════════

# ── AI Provider Keys (Server-side only — no NEXT_PUBLIC_ prefix) ──────────
# These are used exclusively in /api/ai-analyze route (server-side).
# They are NOT exposed to the client browser bundle.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Gold / Forex Data API ─────────────────────────────────────────────────
# Used server-side only in /api/ai-analyze and /api/gold-price
GOLD_API_KEY=your_gold_api_key_here
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ── Telegram Bot (Server-side only — NEVER expose in client bundle) ────────
# Telegram alerts are now dispatched via /api/telegram/alert (server route).
# Users must also enter these in the Settings UI — stored in localStorage.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Supabase (Public keys — safe to expose to the browser) ────────────────
# These are Supabase publishable/anon keys; they are safe as NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Vercel Cron Secret (Server-side only) ─────────────────────────────────
# Used to authenticate the /api/cron/keep-alive endpoint.
CRON_SECRET=your_cron_secret_here
